  "endings": {
    "car": {
      "t": "《闸 门》",
      "l": [
        "你踩下油门的时候，雨刷自己在动。",
        "后视镜里，教学楼一扇一扇地暗下去。",
        "你没敢回头看副驾。"
      ]
    },
    "face": {
      "t": "《白名单》",
      "l": [
        "闸机亮了一下绿光。",
        "你走出去，回头看了一眼——",
        "里面的天还是黑白的。"
      ]
    },
    "trash": {
      "t": "《第三个桶》",
      "l": [
        "桶盖在头顶合上。",
        "你听见垃圾车发动的声音。",
        "有人在外面敲了两下桶壁。"
      ]
    },
    "beast": {
      "t": "《先 辈》",
      "l": [
        "门是被从外面撞开的。",
        "你看清了那个背影——然后你跟着跑了出去。",
        "整座学校第一次有了颜色。"
      ]
    },
    "hollow": {
      "t": "《替 身》",
      "l": [
        "他终于说话了。用的是你的声音。",
        "你把名字留在天台，他穿着你的校服下了楼。",
        "第二天点名时，回答「到」的那个人没有回头。"
      ]
    },
    "lastrow": {
      "t": "《最后一排》",
      "l": [
        "你在空白名册上签下了名字。",
        "最后一排多出一张课桌，座位上坐着昨天的你。",
        "下课铃响了很久。这一节课没有结束。"
      ]
    },
    "callback": {
      "t": "《回 拨》",
      "l": [
        "三段录音拼成了一句：「别接。」",
        "你还是回拨了那个没有号码的来电。",
        "听筒里是你的呼吸。教室里，每一部手机同时亮了。"
      ]
    }
  },
